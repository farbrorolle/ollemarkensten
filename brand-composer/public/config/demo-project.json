    { "id": "chorus", "name": "Chorus", "activeTracks": ["kick", "snare", "hihat", "keys", "synth", "pad", "fx"] }
  ],
  "arrangement": [
    { "bar": 1, "section": "verse" },
    { "bar": 9, "section": "chorus", "transition": "riser" }
  ],
  "loopBars": 16
