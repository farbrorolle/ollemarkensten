  "sidechains": [
    { "id": "kick-to-bass", "source": "kick", "target": "bass", "threshold": -24, "ratio": 6, "attack": 0.01, "release": 0.28 },
    { "id": "kick-to-synth", "source": "kick", "target": "synth", "threshold": -20, "ratio": 4, "attack": 0.015, "release": 0.35 }
